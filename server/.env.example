# Copy this file to server/.env and fill in your own values. Never commit .env.

# GitHub personal access token (required for the GitHub tools).
# Classic PAT with `repo` scope, or a fine-grained token with read access to
# your repos plus Issues: Read and write if you want create_issue to work.
GITHUB_TOKEN=

# Groq API key (optional). Powers the natural-language layer of POST /chat.
# Without it, /chat falls back to built-in intent matching and still works.
GROQ_API_KEY=

# Port for the server (MCP endpoint + /chat). Default 3001.
PORT=3001
